# Default: ~/.local/share/herdlink/herdlink.db (directory created automatically).
# Uncomment to override:
# DATABASE_URL=sqlite://another.db
BIND_ADDR=127.0.0.1:3000
RUST_LOG=backend=info,tower_http=info

# Graph viewer reads Neo4j; chat tools also cache new biomedical data here.
NEO4J_URI=127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Streaming graph chat (credentials stay on the backend).
OPENAI_MODEL=gpt-6-luna
# OPENAI_API_KEY=
# Alternative: an absolute path to an existing Codex login file.
# OPENAI_AUTH_FILE=/home/you/.codex/auth.json
# Optional: OPENAI_BASE_URL=

# A full HPO/Mondo snapshot enables phenotype similarity. The backend also
# discovers ./phenotype-data when started from the repository root.
# HPO_DATA_DIR=/absolute/path/to/phenotype-data
# HERDLINK_QUERY_CACHE_DIR=/absolute/path/to/.graph-query-cache
