[{"id":"19894120","pmid":19894120,"pmcid":null,"infons":{},"passages":[{"infons":{"article-id_pmc":"PMC4051155","authors":"Silverstein PS, Audus KL, Qureshi N, Kumar A","journal":"J Neuroimmune Pharmacol. 2010 Dec;5(4):516-20. doi: 10.1007/s11481-009-9180-4. ","type":"title","year":"2010"},"offset":0,"text":"Lipopolysaccharide increases the expression of multidrug resistance-associated protein 1 (MRP1) in RAW 264.7 macrophages.","sentences":[],"annotations":[{"id":"4","infons":{"type":"Chemical","accession":"@CHEMICAL_Lipopolysaccharides","identifier":"MESH:D008070","name":"Lipopolysaccharides","database":"ncbi_mesh","biotype":"chemical","valid":true,"normalized":["D008070"],"normalized_id":"D008070"},"text":"Lipopolysaccharide","locations":[{"offset":0,"length":18}]},{"id":"5","infons":{"type":"Gene","accession":"@GENE_ABCC1","identifier":"4363","name":"ABCC1","database":"ncbi_gene","biotype":"gene","valid":true,"ncbi_homologene":"133779","normalized":[4363],"normalized_id":4363},"text":"multidrug resistance-associated protein 1","locations":[{"offset":47,"length":41}]},{"id":"6","infons":{"type":"Gene","accession":"@GENE_ABCC1","identifier":"4363","name":"ABCC1","database":"ncbi_gene","biotype":"gene","valid":true,"ncbi_homologene":"133779","normalized":[4363],"normalized_id":4363},"text":"MRP1","locations":[{"offset":90,"length":4}]},{"id":"7","infons":{"type":"CellLine","accession":null,"identifier":"CVCL:0493","name":"0493","database":"cvcl","biotype":"cellline","valid":true,"normalized":["0493"],"normalized_id":"0493"},"text":"RAW 264.7","locations":[{"offset":99,"length":9}]}],"relations":[]},{"infons":{"type":"abstract"},"offset":122,"text":"Multidrug resistance-associated protein 1 (MRP-1) is a ubiquitously expressed member of the ATP-binding cassette transporter family. MRP-1 is one of the primary transporters of glutathione and glutathione conjugates. This protein also transports antiretroviral therapeutics, such as HIV-1 protease inhibitors (PI). We hypothesized that inflammatory mediators that activate macrophages would modify the expression and activity of MRP-1 in macrophages. Real-time PCR assays, western blots, and calcein efflux assays were used to show that exposure of macrophage cell line RAW 264.7 to lipopolysaccharide (LPS) increased expression of MRP-1 at the levels of mRNA, protein, and functional activity. Treatment of macrophages with LPS resulted in 2-fold increases of MRP-1 expression or functional activity. LPS-mediated increases in calcein efflux were repressed by the MRP-specific inhibitor MK-571. These results suggest that the effectiveness of HIV-1 PI therapy may be compromised by the presence of opportunistic infections.","sentences":[],"annotations":[{"id":"30","infons":{"type":"Gene","accession":"@GENE_ABCC1","identifier":"4363","name":"ABCC1","database":"ncbi_gene","biotype":"gene","valid":true,"ncbi_homologene":"133779","normalized":[4363],"normalized_id":4363},"text":"Multidrug resistance-associated protein 1","locations":[{"offset":122,"length":41}]},{"id":"31","infons":{"type":"Gene","accession":"@GENE_ABCC1","identifier":"4363","name":"ABCC1","database":"ncbi_gene","biotype":"gene","valid":true,"ncbi_homologene":"133779","normalized":[4363],"normalized_id":4363},"text":"MRP-1","locations":[{"offset":165,"length":5}]},{"id":"32","infons":{"type":"Gene","accession":"@GENE_ABCA4","identifier":"24","name":"ABCA4","database":"ncbi_gene","biotype":"gene","valid":true,"ncbi_homologene":"298","normalized":[24],"normalized_id":24},"text":"ATP-binding cassette transporter","locations":[{"offset":214,"length":32}]},{"id":"33","infons":{"type":"Gene","accession":"@GENE_ABCC1","identifier":"4363","name":"ABCC1","database":"ncbi_gene","biotype":"gene","valid":true,"ncbi_homologene":"133779","normalized":[4363],"normalized_id":4363},"text":"MRP-1","locations":[{"offset":255,"length":5}]},{"id":"34","infons":{"type":"Chemical","accession":"@CHEMICAL_Glutathione","identifier":"MESH:D005978","name":"Glu