{
  "name": "herdlink-web",
  "version": "0.5.1",
  "private": true,
  "description": "Herdlink frontend for biomedical graph exploration, conversations, communities, and surveys",
  "author": "Herdlink contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/herdlink/herdlink.git"
  },
  "homepage": "https://github.com/herdlink/herdlink",
  "bugs": {
    "url": "https://github.com/herdlink/herdlink/issues"
  },
  "keywords": [
    "herdlink",
    "biomedical-research",
    "disease-communities",
    "graph-exploration",
    "nextjs",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:graph": "bun test src/components/graph/graph-model.test.ts",
    "test:chat": "bun test src/lib/chat-stream.test.ts",
    "check": "bun run lint && bun run typecheck && bun run test:graph && bun run test:chat && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@sigma/edge-curve": "^3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sigma": "^3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
